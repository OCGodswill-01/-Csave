# Copy to .env on the SERVER only. Never commit .env.

# MongoDB connection string
DATABASE_URL=

# HTTP port (default 3000)
PORT=3000

# JWT signing secret — must be ≥ 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key for card tokens — must be exactly 64 hex chars. Generate: openssl rand -hex 32
# Auto-save will return 503 if this is missing or invalid.
TOKEN_KEY=

# Flutterwave secret key (server-side only)
FLW_SECRET_KEY=

# Flutterwave webhook verification hash (≥ 16 chars)
FLW_WEBHOOK_HASH=

# Where Flutterwave redirects the member after payment.
# Use the built-in payment return page on this server: https://<your-server-address>/pay/return
# (If you leave this empty and set PUBLIC_BASE_URL, the page at PUBLIC_BASE_URL/pay/return is used.)
PAYMENT_REDIRECT_URL=https://your-server-address/pay/return
# Public address of this server, no trailing slash (used to build the payment return page address)
PUBLIC_BASE_URL=https://your-server-address
# Optional button on the payment return page (must start with https://), for example your website or app page
PAYMENT_BACK_URL=

# Resend API key for transactional email
RESEND_API_KEY=

# From address for outbound email
EMAIL_FROM=CSave <onboarding@resend.dev>

# DeepSeek API key for support AI, coach, and admin agent
DEEPSEEK_API_KEY=

# Optional separate key for the encrypted KYC ID numbers (64 hex chars). Falls back to TOKEN_KEY.
KYC_KEY=
# How many DIFFERENT staff must approve a KYC (default 2). Use 1 only for a one-person demo.
KYC_APPROVALS_REQUIRED=2

# Crash and session reports from the app. Same value as TELEMETRY_KEY in app/flutter_app.env. Empty = switched off.
TELEMETRY_KEY=

# Countries allowed to sign in (comma list, default NG). Uses Cloudflare's cf-ipcountry header.
ALLOWED_COUNTRIES=NG
# Set to 1 only if you trust the x-country header (it is easy to fake). Leave 0 behind Cloudflare.
TRUST_X_COUNTRY=0

# AI features (coach, Help chat, admin agent). AI_ENABLED=0 switches them all off.
AI_ENABLED=1
AI_BASE_URL=https://api.deepseek.com

# WHO GETS TOLD when money or a ticket needs a person (uncertain withdrawal, failed refund, payment for a missing plan, escalated ticket).
# ALERT_EMAIL: one or more addresses, comma separated. ALERT_WEBHOOK_URL: optional https URL (Slack, Discord, Make, Zapier).
# Set at least one. Without it the alert is only written to the server log and NOBODY is told.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# Public URL of cooperative bylaws (linked in membership email)
BYLAWS_URL=

# Origin secret. Generate: openssl rand -hex 32. Set the SAME value in the Cloudflare transform rule
# (request header X-Origin-Secret). The server refuses to start without it and rejects any request that lacks it.
ORIGIN_SECRET=

# Public URL of the admin console (for invite links)
ADMIN_WEB_URL=https://your-server-address

# Default YEARLY interest rate in percent (5 = 5% a year). The 01:05 Lagos job pays rate / 365 of the balance each day.
# Used only if no rate has been approved in the console (Approvals). The console shows the same yearly number.
DEFAULT_INTEREST_RATE_PERCENT=0

# BVN checks for KYC through Dojah (https://dojah.io). Keys are created in the Dojah dashboard.
# Without them BVN submissions are accepted but marked "not checked" for staff.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Largest single manual wallet credit by staff (default 50000). Larger amounts are refused until dual approval exists.
MANUAL_CREDIT_MAX=50000
